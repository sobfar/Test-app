<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rz — نزدیک انقضا"
        android:textColor="#1565C0"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView android:id="@+id/w_l1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#212121" android:textSize="13sp" android:visibility="gone" />
    <TextView android:id="@+id/w_l2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#212121" android:textSize="13sp" android:visibility="gone" />
    <TextView android:id="@+id/w_l3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#212121" android:textSize="13sp" android:visibility="gone" />
    <TextView android:id="@+id/w_l4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#212121" android:textSize="13sp" android:visibility="gone" />
    <TextView android:id="@+id/w_l5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#212121" android:textSize="13sp" android:visibility="gone" />

    <TextView
        android:id="@+id/w_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#757575"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
